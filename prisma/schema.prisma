generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  clerkId                String                  @unique
  email                  String                  @unique
  createdAt              DateTime                @default(now())
  referredByCode         String?
  subscription           Subscription?
  usageRecords           UsageRecord[]
  tcExtensionActivation  TCExtensionActivation?
}

model Affiliate {
  id              String       @id @default(cuid())
  code            String       @unique
  name            String
  email           String?
  address         String?
  phone           String?
  website         String?
  stripeAccountId String?      // Stripe Connect Express account ID
  status          String       @default("pending_stripe") // pending_stripe | active | suspended
  createdAt       DateTime     @default(now())
  commissions     Commission[]
}

model Commission {
  id               String    @id @default(cuid())
  affiliateCode    String
  affiliate        Affiliate @relation(fields: [affiliateCode], references: [code])
  userId           String
  stripeInvoiceId  String    @unique
  amountCents      Int       // 30% of invoice amount in cents
  status           String    @default("pending") // pending | paid
  createdAt        DateTime  @default(now())
  paidAt           DateTime?

  @@index([affiliateCode, status])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id])
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  plan                 String    @default("trial") // trial | monthly | annual | free | bundle
  status               String    @default("active") // active | canceled | past_due
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  sessionsUsed         Int       @default(0)
  bonusSessions        Int       @default(0)
  sessionsResetAt      DateTime?
  subtamerKeyUsed      String?   // SubTamer license key validated at bundle signup; rechecked by cron/bundle-recheck
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  feature   String   // clarify_audio | summary | transcript | definition
  videoId   String
  createdAt DateTime @default(now())

  @@index([userId, feature, createdAt])
}

model SavedVideo {
  id           String   @id  // YouTube video ID
  url          String
  title        String
  dateSaved    DateTime @default(now())
  isPersistent Boolean  @default(false)
}

model EmailInterest {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model SubTamerLicense {
  id                   String    @id @default(cuid())
  email                String    @unique
  licenseKey           String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  status               String    @default("active") // active | canceled
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Gates the video-indexing feature ported into TC's own Chrome extension.
// Only ever issued to users with an active paid Subscription (see
// app/api/webhooks/stripe/route.ts and app/api/tc-extension/activate/route.ts) —
// a real SubTamer license key is never accepted here, keeping this firewalled
// off from ordinary $4.99 SubTamer subscribers.
model TCExtensionActivation {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  activationKey String   @unique
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Library {
  id        String         @id @default(cuid())
  clerkId   String
  name      String
  createdAt DateTime       @default(now())
  videos    LibraryVideo[]

  @@index([clerkId])
}

model LibraryVideo {
  id         String   @id @default(cuid())
  libraryId  String
  library    Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  videoId    String
  title      String
  url        String
  thumbnail  String?
  addedAt    DateTime @default(now())

  @@unique([libraryId, videoId])
  @@index([libraryId])
}
