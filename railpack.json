{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": ["curl", "ca-certificates"],
  "steps": {
    "yt-dlp-install": {
      "inputs": [{ "step": "build" }],
      "commands": [
        "mkdir -p .railpack-bin",
        "curl -fL --retry 3 --retry-delay 2 https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o .railpack-bin/yt-dlp",
        "SIZE=$(stat -c%s .railpack-bin/yt-dlp); if [ $SIZE -lt 1000000 ]; then echo ERROR: yt-dlp download too small - only $SIZE bytes, expected several MB - failing build instead of shipping a broken binary; exit 1; fi",
        "chmod +x .railpack-bin/yt-dlp"
      ],
      "deployOutputs": [
        { "include": [".railpack-bin"] }
      ]
    }
  },
  "deploy": {
    "aptPackages": ["ffmpeg"],
    "paths": ["/app/.railpack-bin"]
  }
}
