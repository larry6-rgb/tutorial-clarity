{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": ["curl", "ca-certificates"],
  "steps": {
    "yt-dlp-install": {
      "inputs": [{ "step": "build" }],
      "commands": [
        "mkdir -p .railpack-bin",
        "curl -fL --retry 3 --retry-delay 2 https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o .railpack-bin/yt-dlp",
        "test $(stat -c%s .railpack-bin/yt-dlp) -gt 1000000 || { echo \"ERROR: yt-dlp download looks corrupted/truncated ($(stat -c%s .railpack-bin/yt-dlp) bytes, expected several MB) - failing build instead of shipping a broken binary\"; exit 1; }",
        "chmod +x .railpack-bin/yt-dlp"
      ],
      "deployOutputs": [
        { "include": [".railpack-bin"] }
      ]
    }
  },
  "deploy": {
    "aptPackages": ["ffmpeg"],
    "paths": ["/app/.railpack-bin"]
  }
}
